 <LayoutItem anchorPoint="0" background="false" blendMode="0" excludeFromExports="0" file=":/images/north_arrows/layout_default_north_arrow.svg" frame="false" frameJoinStyle="miter" groupUuid="" id="North Arrow" itemRotation="0" mapUuid="{4239f5d3-7196-49ee-96b8-28967d6c3f63}" mode="2" northMode="0" northOffset="0" opacity="1" outlineWidthM="0.3,mm" pictureHeight="14.038" pictureRotation="0" pictureWidth="11.121" position="7.16622,121.161,mm" positionLock="false" positionOnPage="7.16622,121.161,mm" referencePoint="0" resizeMode="0" size="16.2533,14.038,mm" svgBorderColor="0,0,0,255,rgb:0,0,0,1" svgBorderWidth="0.2" svgFillColor="255,255,255,255,rgb:1,1,1,1" templateUuid="{8276f51d-a28e-4f49-9478-693b2fa22cdf}" type="65640" uuid="{8276f51d-a28e-4f49-9478-693b2fa22cdf}" visibility="1" zValue="9">
