 <LayoutItem background="true" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="Key figures box" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:7pt; line-height:1.4;&quot;>&#xa;&lt;b style=&quot;font-size:11pt; color:#000000;&quot;>Protection and ecological indicators&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#be5a5a;&quot;>Sealed surface (built-up and transport):&lt;/b>&#xa;&lt;b>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot; IN ('Built-up','Transport'))/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %] %&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#000000;&quot;>Nature reserves (NSG):&lt;/b>&#xa;&lt;b>[% coalesce(aggregate('H07a_innenstadt_ost_nature_reserves_NSG_25832','count',$id,filter:=area($geometry)>1000),0) %]&lt;/b>&#xa;(&lt;b>[% coalesce(round(aggregate('H07a_innenstadt_ost_nature_reserves_NSG_25832','sum',area($geometry),filter:=area($geometry)>1000)/10000,1),0) %] ha&lt;/b>)&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#6a3d9a;&quot;>Landscape protection area (LSG):&lt;/b>&#xa;&lt;b>[% coalesce(round(aggregate('H07b_innenstadt_ost_landscape_protection_LSG_25832','sum',area($geometry))/10000,1),0) %] ha&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#2ca02c;&quot;>Protected landscape components:&lt;/b> &lt;b>2&lt;/b>&#xa;(&lt;b>[% round((coalesce(aggregate('H18b_innenstadt_ost_ostfriedhof_protected_trees_25832','sum',area($geometry)),0) + coalesce(aggregate('H18c_innenstadt_ost_pond_bird_grove_25832','sum',area($geometry)),0))/10000,1) %] ha&lt;/b>: Ostfriedhof, pond and bird grove)&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#e6ac00;&quot;>Natural monuments (protected old trees):&lt;/b>&#xa;&lt;b>[% coalesce(aggregate('H18a_innenstadt_ost_natural_monuments_25832','count',$id),0) %]&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#3182bd;&quot;>Streams (open water courses):&lt;/b>&#xa;&lt;b>[% coalesce(round(aggregate('H08_innenstadt_ost_streams_25832','sum',length($geometry))/1000,2),0) %] km&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#1b7a3a;&quot;>Street and park trees:&lt;/b>&#xa;&lt;b>[% aggregate('H09_innenstadt_ost_trees_4326','count',$id) %]&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#2171b5;&quot;>Species records (GBIF 2010 to 2026):&lt;/b>&#xa;&lt;b>[% aggregate('H10a_innenstadt_ost_species_gbif_25832','count',$id) %]&lt;/b>&lt;br>&#xa;&#xa;&lt;b style=&quot;color:#2171b5;&quot;>Number of species (GBIF 2010 to 2026):&lt;/b>&#xa;&lt;b>[% aggregate('H10a_innenstadt_ost_species_gbif_25832','count_distinct',&quot;species&quot;) %]&lt;/b>&#xa;&lt;/div>" marginX="2" marginY="1" opacity="1" outlineWidthM="0.3,mm" position="5.04715,5.46805,mm" positionLock="false" positionOnPage="5.04715,5.46805,mm" referencePoint="0" size="65.5624,51.2424,mm" templateUuid="{37fbad18-0cf0-4de8-bea1-7bff1accfce8}" type="65641" uuid="{37fbad18-0cf0-4de8-bea1-7bff1accfce8}" valign="32" visibility="1" zValue="4">
