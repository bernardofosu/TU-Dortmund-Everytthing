 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:8pt;&quot;>&#xa;&#xa;&lt;div style=&quot;font-size:9pt; font-weight:bold; line-height:16px;&quot;>Habitat classes (ALKIS land use)&lt;/div>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#1b7a3a; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Woodland&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#7fc97f; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Urban green (parks, cemeteries, sports grounds)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#e6dc8c; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Open land / agriculture&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#3182bd; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Water&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#cdaa7d; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Bare / pioneer land&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#be5a5a; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Built-up&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#aaaaaa; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Transport&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&#xa;&lt;div style=&quot;font-size:9pt; font-weight:bold; line-height:16px; margin-top:5px;&quot;>Protection, trees and light at night&lt;/div>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#6a3d9a; font-size:10pt;&quot;>&amp;#9640;&lt;/span>&lt;/td>&lt;td>Landscape protection area (LSG)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#33dd33; font-size:10pt;&quot;>&amp;#9633;&lt;/span>&lt;/td>&lt;td>Protected landscape component (Ostfriedhof, pond)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#e6ac00; font-size:10pt;&quot;>&amp;#9733;&lt;/span>&lt;/td>&lt;td>Natural monument (protected old tree)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#000000; font-size:10pt;&quot;>&amp;#9641;&lt;/span>&lt;/td>&lt;td>Dark green areas (black corridor)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#f2dc8c; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Light zone (25 m around lit roads, assumption)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#00441b; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Street and park tree&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#000000; font-size:8pt;&quot;>&amp;#9670;&lt;/span>&lt;/td>&lt;td>Key place&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#7f7f7f; font-size:10pt; font-weight:bold;&quot;>&amp;#9473;&lt;/span>&lt;/td>&lt;td>Main road&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#bdbdbd; font-size:10pt;&quot;>&amp;#9472;&lt;/span>&lt;/td>&lt;td>Street&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#ff00ff; font-size:10pt;&quot;>&amp;#9633;&lt;/span>&lt;/td>&lt;td>District boundary&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&#xa;&lt;div style=&quot;font-size:9pt; font-weight:bold; line-height:16px; margin-top:5px;&quot;>Species records (GBIF 2010 to 2026)&lt;/div>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#2171b5; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Birds&lt;/td>&lt;td width=&quot;16&quot; align=&quot;center&quot; style=&quot;padding-left:10px;&quot;>&lt;span style=&quot;color:#41ab5d; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Vascular plants&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#08306b; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Mammals&lt;/td>&lt;td width=&quot;16&quot; align=&quot;center&quot; style=&quot;padding-left:10px;&quot;>&lt;span style=&quot;color:#8c9e2b; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Mosses, liverworts&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#4eb3d3; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Amphibians, reptiles&lt;/td>&lt;td width=&quot;16&quot; align=&quot;center&quot; style=&quot;padding-left:10px;&quot;>&lt;span style=&quot;color:#dd3497; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Fungi, lichens&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#e34a33; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Insects&lt;/td>&lt;td width=&quot;16&quot; align=&quot;center&quot; style=&quot;padding-left:10px;&quot;>&lt;span style=&quot;color:#969696; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Other&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#a63603; font-size:8pt;&quot;>&amp;#9679;&lt;/span>&lt;/td>&lt;td>Other invertebrates&lt;/td>&lt;td>&lt;/td>&lt;td>&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&#xa;&lt;div style=&quot;font-size:9pt; font-weight:bold; line-height:16px; margin-top:5px;&quot;>Basemap&lt;/div>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#d9d9d9; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Esri Light Gray Canvas (base)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;line-height:13px;&quot;>&lt;td width=&quot;16&quot; align=&quot;center&quot;>&lt;span style=&quot;color:#6e6e6e; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&lt;/td>&lt;td>Esri Light Gray Reference (place names)&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="223.387,23.943,mm" positionLock="false" positionOnPage="223.387,23.943,mm" referencePoint="0" size="73.0665,116.502,mm" templateUuid="{1affdc1f-836b-4eef-ae8b-d08ffc5439b1}" type="65641" uuid="{1affdc1f-836b-4eef-ae8b-d08ffc5439b1}" valign="32" visibility="1" zValue="6">
