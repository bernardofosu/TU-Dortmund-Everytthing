 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:7pt; line-height:1.3;&quot;>&#xa;&lt;b style=&quot;font-size:10pt;&quot;>Climate interactions (IF / THEN)&lt;/b>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse; margin-top:3px; font-size:7pt;&quot;>&#xa;&lt;tr bgcolor=&quot;#d9d9d9&quot;>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>&lt;b>Climate&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>&lt;b>IF&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>&lt;b>THEN&lt;/b>&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot; rowspan=&quot;3&quot; bgcolor=&quot;#fde0d2&quot;>&lt;b>Temp.&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>hot days &amp;#8593;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>urban tree species beyond their climate range &amp;#8593; (UBA, 2023; Esperon-Rodriguez et al., 2022)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>mean temperature &amp;#8593;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>spring earlier, growing season &amp;#8593; (Menzel et al., 2006)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>heat load &amp;#8593;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>cooling by green areas more important; green lost = cooling &amp;#8595; (Knight et al., 2021)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot; rowspan=&quot;2&quot; bgcolor=&quot;#deebf7&quot;>&lt;b>Rain&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>summer soil moisture &amp;#8595;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>street tree vitality &amp;#8595;, damage &amp;#8593; (IPCC, 2021; Haase &amp;amp; Hellwig, 2022)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>precipitation beyond tolerance&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>tree species at risk &amp;#8593; (Esperon-Rodriguez et al., 2022)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #999;&quot; bgcolor=&quot;#f0f0f0&quot;>&lt;b>Snow&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>snow season and depth &amp;#8595;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #999;&quot;>winter refuge under snow &amp;#8595;; amphibians wake too early (Pauli et al., 2013)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;/table>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="216.3,143.059,mm" positionLock="false" positionOnPage="216.3,143.059,mm" referencePoint="0" size="79.4012,60.568,mm" templateUuid="{934dd690-9e86-44e4-8d2c-e59910023934}" type="65641" uuid="{934dd690-9e86-44e4-8d2c-e59910023934}" valign="32" visibility="1" zValue="11">
