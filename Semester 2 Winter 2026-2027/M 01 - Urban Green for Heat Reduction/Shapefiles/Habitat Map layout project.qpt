 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial;&quot;>&#xa;&lt;b style=&quot;font-size:11pt;&quot;>Habitat cover and patches&lt;/b>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse; font-size:8pt; margin-top:4px;&quot;>&#xa;&lt;tr bgcolor=&quot;#bfbfbf&quot;>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>Class&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>Area (ha)&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>Share (%)&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>Patches&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888;&quot;>Largest (ha)&lt;/th>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#be5a5a&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Built-up&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Built-up'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Built-up')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Built-up') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Built-up'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#aaaaaa&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Transport&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Transport'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Transport')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Transport') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Transport'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#7fc97f&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Urban green&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Urban green'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Urban green')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Urban green') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Urban green'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#1b7a3a&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Woodland&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Woodland'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Woodland')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Woodland') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Woodland'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#3182bd&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Water&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Water'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Water')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Water') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Water'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#e6dc8c&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Open land / agriculture&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Open land / agriculture'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Open land / agriculture')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Open land / agriculture') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Open land / agriculture'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td bgcolor=&quot;#cdaa7d&quot; style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>Bare / pioneer land&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Bare / pioneer land'),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(100*aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Bare / pioneer land')/aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Bare / pioneer land') %]&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','max',&quot;area_ha&quot;,filter:=&quot;habitat_8class&quot;='Bare / pioneer land'),1) %]&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr bgcolor=&quot;#eeeeee&quot;>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&lt;b>Total&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&lt;b>[% round(aggregate('H05_innenstadt_ost_habitat_patches_dissolve','sum',&quot;area_ha&quot;),1) %]&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&lt;b>100&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&lt;b>[% aggregate('H05_innenstadt_ost_habitat_patches_dissolve','count',&quot;area_ha&quot;) %]&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&lt;/td>&#xa;&lt;/tr>&#xa;&lt;/table>&#xa;&lt;span style=&quot;font-size:7pt; color:#555555;&quot;>No wetland in the district. Patches = connected areas of one class after dissolving cadastral parcels.&lt;/span>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="2.57296,141.077,mm" positionLock="false" positionOnPage="2.57296,141.077,mm" referencePoint="0" size="87.183,68.923,mm" templateUuid="{341daa4c-837e-4c46-