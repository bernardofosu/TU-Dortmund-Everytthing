 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="soureces" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:6pt; color:#555555;&quot;>&#xa;Data: ALKIS land use, &lt;a href=&quot;https://open-data.dortmund.de/explore/dataset/liegenschaftskataster-nutzart/&quot; style=&quot;color:#2171b5;&quot;>Stadt Dortmund (2026)&lt;/a>.&#xa;Landscape protection areas and biotopes, &lt;a href=&quot;https://www.opengeodata.nrw.de/produkte/umwelt_klima/naturschutz/linfos/&quot; style=&quot;color:#2171b5;&quot;>LANUK NRW (2026)&lt;/a>.&#xa;Street trees: &lt;a href=&quot;https://open-data.dortmund.de/explore/dataset/baumkataster/&quot; style=&quot;color:#2171b5;&quot;>Baumkataster Dortmund (2026)&lt;/a>.&#xa;Species: &lt;a href=&quot;https://www.gbif.org/occurrence/download/0003823-261104105008071&quot; style=&quot;color:#2171b5;&quot;>GBIF.org (2026), GBIF Occurrence Download 0003823-261104105008071&lt;/a>.&#xa;Literature: Beninde et al. (2015). Basemap: Esri Light Gray. EPSG:25832.&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="222.841,198.982,mm" positionLock="false" positionOnPage="222.841,198.982,mm" referencePoint="0" size="72.8603,28.2091,mm" templateUuid="{6a273ab6-3b04-4027-97c8-1e6cd20e7f76}" type="65641" uuid="{6a273ab6-3b04-4027-97c8-1e6cd20e7f76}" valign="32" visibility="1" zValue="5">
