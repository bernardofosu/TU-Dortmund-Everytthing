 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="map  2 legend" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:6.5pt;&quot;>&#xa;&lt;b>Night situation (04:00)&lt;/b>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;1&quot; style=&quot;font-size:6pt; font-family:Arial; margin-top:3px;&quot;>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot;>&lt;b>Built-up: air temperature&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#fee5d9&quot;>&amp;nbsp;&lt;/td>&lt;td>up to 17 °C&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#fcae91&quot;>&amp;nbsp;&lt;/td>&lt;td>17–18 °C&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#fb6a4a&quot;>&amp;nbsp;&lt;/td>&lt;td>18–19 °C&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#cb181d&quot;>&amp;nbsp;&lt;/td>&lt;td>above 19 °C&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot; style=&quot;padding-top:4px;&quot;>&lt;b>Green: cold air flow (m³/(s·m))&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#deebf7&quot;>&amp;nbsp;&lt;/td>&lt;td>up to 5&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#9ecae1&quot;>&amp;nbsp;&lt;/td>&lt;td>5–10&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#6baed6&quot;>&amp;nbsp;&lt;/td>&lt;td>10–20&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#3182bd&quot;>&amp;nbsp;&lt;/td>&lt;td>20–50&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td width=&quot;14&quot; bgcolor=&quot;#08519c&quot;>&amp;nbsp;&lt;/td>&lt;td>above 50&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="44.5611,160.39,mm" positionLock="false" positionOnPage="44.5611,160.39,mm" referencePoint="0" size="15.994,48.4725,mm" templateUuid="{f8a8d0bf-81cf-45d9-8b04-8776f2c1f90c}" type="65641" uuid=