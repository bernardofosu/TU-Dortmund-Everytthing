 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="legend1" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial;&quot;>&#xa;&lt;b style=&quot;font-size:9pt;&quot;>Thermal component: heat load (day and night)&lt;/b>&#xa;&lt;span style=&quot;font-size:6.5pt; color:#555555;&quot;> (LANUK 2026, Klimaanalyse NRW; classes after SenSBW / GEO-NET 2025)&lt;/span>&#xa;&lt;table style=&quot;border-collapse:collapse; width:100%; font-size:7pt; margin-top:4px;&quot;>&#xa;&lt;tr style=&quot;background:#bfbfbf;&quot;>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px; width:16%;&quot;>Category&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px; width:26%;&quot;>Name&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px;&quot;>Description&lt;/th>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; background:#1a9641; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Cooling area&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Open land, forest, urban green and water. Cold- and fresh-air generation.&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; background:#a6d96a; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Low heat load&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Built-up. Low heat load by day and night.&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; background:#fee08b; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Moderate heat load&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Built-up. PET 29–35 °C by day, or slightly warm nights (17–18 °C).&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; background:#f46d43; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Strong heat load&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Built-up. PET 35–41 °C by day and/or warm nights (18–19 °C).&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; background:#a50026; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Extreme heat load&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Built-up. PET above 41 °C by day and/or very warm nights (above 19 °C).&lt;/td>&#xa;&lt;/tr>&#xa;&lt;/table>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="215.872,14.9939,mm" positionLock="false" positionOnPage="215.872,14.9939,mm" referencePoint="0" size="78.2915,49.8827,mm" templateUuid="{0a4c6e29-f605-4bc0-9d41-8a56603a768c}" type="65641" uuid="{0a4c6e29-f605-4bc0-9d41-8a56603a768c}" valign="32" visibility="1" zValue="5">
