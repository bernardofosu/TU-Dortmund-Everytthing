 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:7pt;&quot;>&#xa;&lt;b style=&quot;font-size:9pt;&quot;>Climatopes (outline)&lt;/b>&#xa;&lt;span style=&quot;font-size:6.5pt; color:#555555;&quot;> (LANUK 2026, Klimaanalyse NRW)&lt;/span>&#xa;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;margin-top:2px; line-height:11px;&quot;>&#xa;&lt;tr>&#xa; &lt;td valign=&quot;middle&quot; style=&quot;padding-right:14px;&quot;>&lt;b style=&quot;color:#a6d96a; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Open land climate&lt;/td>&#xa; &lt;td valign=&quot;middle&quot;>&lt;b style=&quot;color:#fec44f; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Urban edge climate&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td valign=&quot;middle&quot; style=&quot;padding-right:14px;&quot;>&lt;b style=&quot;color:#1a7a3a; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Forest climate&lt;/td>&#xa; &lt;td valign=&quot;middle&quot;>&lt;b style=&quot;color:#fd8d3c; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Urban climate&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td valign=&quot;middle&quot; style=&quot;padding-right:14px;&quot;>&lt;b style=&quot;color:#4daf4a; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Inner-city green&lt;/td>&#xa; &lt;td valign=&quot;middle&quot;>&lt;b style=&quot;color:#e31a1c; font-size:8pt;&quot;>&amp;#9633;&lt;/b> City centre climate&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td valign=&quot;middle&quot; style=&quot;padding-right:14px;&quot;>&lt;b style=&quot;color:#4a90d9; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Water bodies&lt;/td>&#xa; &lt;td valign=&quot;middle&quot;>&lt;b style=&quot;color:#c2a5cf; font-size:8pt;&quot;>&amp;#9633;&lt;/b> Commercial / industrial (open)&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td valign=&quot;middle&quot; style=&quot;padding-right:14px;&quot;>&lt;b style=&quot;color:#e6