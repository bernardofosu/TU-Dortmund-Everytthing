 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial;&quot;>&#xa;&lt;b style=&quot;font-size:9pt;&quot;>Dynamic component: cold air&lt;/b>&#xa;&lt;span style=&quot;font-size:6.5pt; color:#555555;&quot;> (LANUK 2026, Klimaanalyse NRW and Planungshinweiskarte)&lt;/span>&#xa;&lt;table style=&quot;border-collapse:collapse; width:100%; font-size:7pt; margin-top:4px;&quot;>&#xa;&lt;tr style=&quot;background:#bfbfbf;&quot;>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px; width:16%;&quot;>Symbol&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px; width:26%;&quot;>Name&lt;/th>&#xa; &lt;th style=&quot;border:1px solid #888; padding:3px;&quot;>Description&lt;/th>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; text-align:center; font-size:14pt; color:#08519c;&quot;>&amp;#8593;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Cold air flow&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Direction and speed of cold air at night (04:00). Arrow size shows speed.&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; height:30px;&quot;>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Cold air production&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Above-average cold air production (more than 26 m³ per m² per hour).&lt;/td>&#xa;&lt;/tr>&#xa;&lt;tr>&#xa; &lt;td style=&quot;border:1px solid #888; text-align:center; font-size:14pt; color:#ffd700;&quot;>&amp;#9733;&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>&lt;b>Air exchange area&lt;/b>&lt;/td>&#xa; &lt;td style=&quot;border:1px solid #888; padding:3px;&quot;>Where cold air from green areas flows into the built-up area.&lt;/td>&#xa;&lt;/tr>&#xa;&lt;/table>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="215.872,62.8826,mm" positionLock="false" positionOnPage="215.872,62.8826,mm" referencePoint="0" size="78.2915,38.4795,mm" templateUuid="{ced3c081-9656-41d2-beca-94e652eec4bf}" type="65641" uuid="{ced3c081-9656-41d2-beca-94e652eec4bf}" valign="32" visibility="1" zValue="6">
