 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial;&quot;>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Key figures&lt;/b>&#xa;&lt;table width=&quot;100%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse; font-size:7pt; margin-top:3px;&quot;>&#xa;&lt;tr style=&quot;background:#bfbfbf;&quot;>&#xa; &lt;th align=&quot;left&quot; style=&quot;border:1px solid #888;&quot;>Indicator&lt;/th>&#xa; &lt;th align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>Value&lt;/th>&#xa;&lt;/tr>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #888; background:#eeeeee;&quot;>&lt;b>Population&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Residents in homes (Zensus 2022)&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>59,273&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Residents aged 65+&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>11,717&lt;/b> (20 %)&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #888; background:#eeeeee;&quot;>&lt;b>Heat and access to green&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Within 300 m of free green &amp;ge; 1 ha (WHO)&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>42 %&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Within 300 m of any free cool place&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>76 %&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Residents in strong or extreme heat&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>8,835&lt;/b> (15 %)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;background:#fde0dd;&quot;>&lt;td style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;of them &amp;gt; 300 m from free green &amp;ge; 1 ha&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>6,626&lt;/b> (75 %)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;background:#fde0dd;&quot;>&lt;td style=&quot;border:1px solid #888;&quot;>&amp;nbsp;&amp;nbsp;of them aged 65+ and &amp;gt; 300 m from free green&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>999&lt;/b> of 1,310 (76 %)&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #888; background:#eeeeee;&quot;>&lt;b>Noise and air&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Road noise &amp;ge; 55 dB Lden (WHO guideline 53 dB)&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>21,235&lt;/b> (36 %)&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Road noise &amp;ge; 60 dB Lden&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>9,757&lt;/b> (16.5 %)&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Within 150 m of a main road (air proxy)&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>29,831&lt;/b> (50 %)&lt;/td>&lt;/tr>&#xa;&lt;tr style=&quot;background:#fde0dd;&quot;>&lt;td style=&quot;border:1px solid #888;&quot;>In strong or extreme heat &lt;i>and&lt;/i> &amp;ge; 55 dB&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>&lt;b>3,634&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td colspan=&quot;2&quot; style=&quot;border:1px solid #888; background:#eeeeee;&quot;>&lt;b>Water&lt;/b>&lt;/td>&lt;/tr>&#xa;&lt;tr>&lt;td style=&quot;border:1px solid #888;&quot;>Drinking water quality&lt;/td>&lt;td align=&quot;right&quot; style=&quot;border:1px solid #888;&quot;>same for all, high (Stadt Dortmund 2024)&lt;/td>&lt;/tr>&#xa;&lt;/table>&#xa;&lt;span style=&quot;font-size:6pt; color:#555555;&quot;>Walking distance along streets; destinations and streets include a 1 km buffer around the district. Noise: only roads &amp;gt; 0.5 million vehicles/year mapped (Stadt Dortmund 2022), so a lower estimate.&lt;/span>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="-24.6907,145.573,mm" positionLock="false" positionOnPage="-24.6907,145.573,mm" referencePoint="0" size="110.49,98.1288,mm" templateUuid="{93405fdb-94b2-4fe6-bd88-4b512dc6bbd3}" type="65641" uuid="{93405fdb-94b2-4fe6-bd88-4b512dc6bbd3}" valign="32" visibility="1" zValue="8">
