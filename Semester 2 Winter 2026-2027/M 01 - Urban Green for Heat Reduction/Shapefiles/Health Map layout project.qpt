 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family:Arial; font-size:8pt; line-height:115%; color:#000000;&quot;>&#xa;&lt;b style=&quot;font-size:11pt;&quot;>Legend&lt;/b>&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Walking distance from home to free green (&amp;ge; 1 ha)&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#1a9850; font-size:10pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;&amp;le; 300 m (about 5 min, WHO)&lt;br>&#xa;&lt;span style=&quot;color:#fdae61; font-size:10pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;300&amp;ndash;500 m (5&amp;ndash;9 min, BfN/UBA)&lt;br>&#xa;&lt;span style=&quot;color:#d7191c; font-size:10pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;&amp;gt; 500 m (more than 9 min)&lt;br>&#xa;&lt;span style=&quot;color:#252525; font-size:6pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;&amp;nbsp;Park entrance (free green)&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Heat-sensitive places&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#7b3294; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Care home / social facility&lt;br>&#xa;&lt;span style=&quot;color:#f16913; font-size:10pt;&quot;>&amp;#9650;&lt;/span>&amp;nbsp;&amp;nbsp;Kindergarten / childcare&lt;br>&#xa;&lt;span style=&quot;color:#2171b5; font-size:10pt;&quot;>&amp;#9670;&lt;/span>&amp;nbsp;&amp;nbsp;School&lt;br>&#xa;&lt;span style=&quot;color:#e31a1c; font-size:10pt;&quot;>&amp;#9633;&lt;/span>&amp;nbsp;&amp;nbsp;Large symbol, red outline: far from free green&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Residents aged 65+ per home&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#6a51a3; font-size:9pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;3&amp;ndash;10&lt;br>&#xa;&lt;span style=&quot;color:#6a51a3; font-size:11pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;10 or more&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Health care&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#1a9850; font-size:10pt;&quot;>&amp;#10010;&lt;/span>&amp;nbsp;&amp;nbsp;Pharmacy&lt;br>&#xa;&lt;span style=&quot;color:#e31a1c; font-size:10pt;&quot;>&amp;#10010;&lt;/span>&amp;nbsp;&amp;nbsp;Hospital / clinic&lt;br>&#xa;&lt;span style=&quot;color:#636363; font-size:10pt;&quot;>&amp;#9679;&lt;/span>&amp;nbsp;&amp;nbsp;Doctor / other&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Heat load&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#7fc8a0; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Cooling area&lt;br>&#xa;&lt;span style=&quot;color:#c5e6a8; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Low heat load&lt;br>&#xa;&lt;span style=&quot;color:#fde9cf; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Moderate heat load&lt;br>&#xa;&lt;span style=&quot;color:#fcb4a4; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Strong heat load&lt;br>&#xa;&lt;span style=&quot;color:#d38085; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Extreme heat load&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Road noise Lden&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#fdf0c4; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;55&amp;ndash;59 dB&lt;br>&#xa;&lt;span style=&quot;color:#fde3a7; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;60&amp;ndash;64 dB&lt;br>&#xa;&lt;span style=&quot;color:#fdcb95; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;65&amp;ndash;69 dB&lt;br>&#xa;&lt;span style=&quot;color:#eba783; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;70&amp;ndash;74 dB&lt;br>&#xa;&lt;span style=&quot;color:#c08b73; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;&amp;ge; 75 dB&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Green not freely accessible&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#7b3294; font-size:10pt;&quot;>&amp;#9640;&lt;/span>&amp;nbsp;&amp;nbsp;Paid entry (Westfalenpark)&lt;br>&#xa;&lt;span style=&quot;color:#636363; font-size:10pt;&quot;>&amp;#9640;&lt;/span>&amp;nbsp;&amp;nbsp;Private / restricted green&lt;br>&#xa;&lt;b style=&quot;font-size:9.5pt;&quot;>Basemap&lt;/b>&lt;br>&#xa;&lt;span style=&quot;color:#7f7f7f; font-size:10pt;&quot;>&amp;#9473;&lt;/span>&amp;nbsp;&amp;nbsp;Main road&lt;br>&#xa;&lt;span style=&quot;color:#bdbdbd; font-size:10pt;&quot;>&amp;#9472;&lt;/span>&amp;nbsp;&amp;nbsp;Street&lt;br>&#xa;&lt;span style=&quot;color:#ff00ff; font-size:10pt;&quot;>&amp;#9633;&lt;/span>&amp;nbsp;&amp;nbsp;Innenstadt-Ost boundary&lt;br>&#xa;&lt;span style=&quot;color:#d9d9d9; font-size:10pt;&quot;>&amp;#9632;&lt;/span>&amp;nbsp;&amp;nbsp;Esri Light Gray Canvas&lt;br>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="210.299,10.8703,mm" positionLock="false" positionOnPage="210.299,10.8703,mm" referencePoint="0" size="87.4512,183.767,mm" templateUuid="{ecd0e9b8-54d4-4a74-882e-1f00e0dee9e9}" type="65641" uuid="{ecd0e9b8-54d4-4a74-882e-1f00e0dee9e9}" valign="32" visibility="1" zValue="3">
